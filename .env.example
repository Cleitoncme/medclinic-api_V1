PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=medclinic
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=1h

# Defina as credenciais reais somente no ambiente local ou publicado.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local: false. Banco gerenciado: true, com verificacao de certificado.
DATABASE_SSL=false
# Opcional: certificado CA PEM do provedor; aceita novas linhas escapadas.
DATABASE_SSL_CA=
# Ative no primeiro deploy para criar o admin com ADMIN_* configurado.
SEED_ADMIN_ON_START=false
