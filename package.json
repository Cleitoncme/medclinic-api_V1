{
  "name": "medclinic-api",
  "version": "1.0.0",
  "description": "API de autenticação e autorização para uma clínica médica.",
  "private": true,
  "scripts": {
    "dev": "tsc --watch",
    "start:dev": "npm run build && node --watch dist/main.js",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "seed:admin": "npm run build && node dist/database/seed-admin.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js",
    "lint": "eslint src",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:cov": "vitest run --coverage",
    "test:regression": "npm run build && node --test tests/*.test.cjs",
    "test:typecheck": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  }
}
